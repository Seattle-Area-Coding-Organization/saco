---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { links, navigation } from '../data/site';

interface Props { title?: string; description?: string; }
const {
  title = 'SACO | Seattle Area Coding Organization',
  description = 'A student-run programming community for pre-college students across the Pacific Northwest. Learn, meet other coders, and compete at SACC.',
} = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#191a20" />
    <link rel="icon" href="/brand/icon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SACO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(path, Astro.site)} />
    <meta property="og:image" content={new URL('/brand/social.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('saco-theme');
        if (savedTheme === 'light' || savedTheme === 'dark') document.documentElement.dataset.theme = savedTheme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label="SACO home">
          <img src="/brand/wordmark.png" alt="SACO" width="902" height="311" fetchpriority="high" />
        </a>
        <nav class="desktop-nav" aria-label="Main navigation">
          {navigation.map(item => <a href={item.href} aria-current={path === item.href ? 'page' : path.startsWith(`${item.href}/`) ? 'location' : undefined}>{item.label}</a>)}
        </nav>
        <div class="header-actions">
          <a class="header-discord text-link" href={links.discord} target="_blank" rel="noopener noreferrer">Join Discord</a>
          <button class="theme-toggle" type="button" aria-label="Switch color theme" title="Switch color theme"><span class="theme-symbol" aria-hidden="true"></span></button>
          <details class="mobile-menu">
            <summary aria-label="Toggle navigation">Menu <span aria-hidden="true">+</span></summary>
            <nav aria-label="Mobile navigation">
              {navigation.map(item => <a href={item.href} aria-current={path === item.href ? 'page' : path.startsWith(`${item.href}/`) ? 'location' : undefined}>{item.label}</a>)}
              <a href={links.discord} target="_blank" rel="noopener noreferrer">Join Discord</a>
            </nav>
          </details>
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer container">
      <div class="footer-top">
        <div class="footer-identity">
          <a href="/" class="brand" aria-label="SACO home"><img src="/brand/wordmark.png" alt="SACO" width="902" height="311" loading="lazy" /></a>
          <p>Seattle Area Coding Organization</p>
        </div>
        <nav aria-label="Footer navigation">{navigation.slice(1).map(item => <a href={item.href}>{item.label}</a>)}</nav>
        <div class="footer-contact"><a class="text-link" href={links.discord} target="_blank" rel="noopener noreferrer">Join Discord</a><a href={links.email}>sacocoding@gmail.com</a></div>
      </div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} SACO</span></div>
    </footer>
    <script>
      import { initializeControls } from '../scripts/controls.js';
      initializeControls(document, window);
    </script>
  </body>
</html>
