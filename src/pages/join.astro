---
import Layout from '../layouts/Layout.astro';
import { links } from '../data/site';
---
<Layout title="Organize with us | SACO" description="Write contest problems, build our technology, or help run events. Apply to the SACO student organizing team.">
  <section class="join-hero container"><div><h1>Help run SACO.</h1></div><div><p>There’s plenty to do behind the scenes: write contest problems, work on the website, or help events run smoothly.</p><a class="button button-primary" href={links.application} target="_blank" rel="noopener noreferrer">Apply to the team</a><p class="application-note">Have a question? <a href={links.email}>Email us.</a></p></div></section>
  <section class="event-format container" aria-labelledby="roles-heading">
    <h2 id="roles-heading">Ways to help.</h2>
    <dl class="role-list">
      <div><dt>Problem writing</dt><dd>Create contest problems, write solutions and test cases, and check difficulty.</dd></div>
      <div><dt>Technology</dt><dd>Build and maintain the website and tools that help us run competitions.</dd></div>
      <div><dt>Logistics</dt><dd>Help coordinate the venue, check-in, schedule, and other details on contest day.</dd></div>
      <div><dt>Outreach</dt><dd>Connect with schools, students, and potential sponsors to help more people take part.</dd></div>
    </dl>
  </section>
</Layout>
