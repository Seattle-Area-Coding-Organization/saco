---
import Layout from '../layouts/Layout.astro';
import SponsorLogo from '../components/SponsorLogo.astro';
import { links, sponsors } from '../data/site';
const featuredSponsors = sponsors.filter(sponsor => ['Platinum', 'Gold'].includes(sponsor.tier));
---
<Layout>
  <section class="hero container">
    <div class="hero-copy">
      <h1>A place for<br />problem solvers.</h1>
      <p class="hero-description">We’re the Seattle Area Coding Organization, a student-run community for pre-college programmers in the Pacific Northwest.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="/sacc">Explore SACC</a>
        <a class="text-link" href={links.discord} target="_blank" rel="noopener noreferrer">Join Discord</a>
      </div>
    </div>
    <a class="hero-event" href="/sacc/2026" aria-label="View the SACC 2026 archive" id="past-events">
      <img src="/photos/home-contest.webp" alt="SACC competitors discussing a programming problem around their laptops" width="1000" height="1100" fetchpriority="high" />
      <div class="hero-event-caption"><span>From SACC 2026</span><time datetime="2026-05-23">May 23, 2026</time></div>
    </a>
  </section>

  <section class="home-programs container" aria-labelledby="programs-heading">
    <h2 id="programs-heading">What we do.</h2>
    <div class="program-layout">
      <article class="program-competition">
        <h3>Regional competitions</h3>
        <p>The Seattle Area Computing Competition (SACC) brings students together to solve algorithmic problems as a team. Here’s how the 2026 contest worked:</p>
        <dl class="program-facts" aria-label="SACC 2026 format">
          <div><dt>Per team</dt><dd>3 <span>students</span></dd></div>
          <div><dt>Contest length</dt><dd>3 <span>hours</span></dd></div>
          <div><dt>Problem set</dt><dd>8 <span>problems</span></dd></div>
        </dl>
        <a class="text-link" href="/sacc/2026">View SACC 2026</a>
      </article>
      <div class="program-notes">
        <article><h3>Workshops & practice</h3><p>Learn through workshops, study groups, and shared problem sets. Beginners are welcome.</p></article>
        <article><h3>A local community</h3><p>Find teammates, compare solutions, and connect with other students who enjoy programming.</p></article>
      </div>
    </div>
  </section>

  <section class="sponsor-preview container" aria-labelledby="sponsors-heading">
    <div class="section-bar"><h2 id="sponsors-heading">Our sponsors</h2><div class="sponsor-actions"><button class="carousel-toggle" type="button" aria-label="Pause sponsor carousel" aria-pressed="false">Pause</button><a class="text-link" href="/sponsors">All sponsors</a></div></div>
    <div class="sponsor-carousel" data-paused="false">
      <div class="sponsor-track">
        <div class="sponsor-group">{featuredSponsors.map(sponsor => <a href={sponsor.href} target="_blank" rel="noopener noreferrer"><SponsorLogo {...sponsor} /></a>)}</div>
        <div class="sponsor-group sponsor-copy" aria-hidden="true">{featuredSponsors.map(sponsor => <a href={sponsor.href} tabindex="-1" target="_blank" rel="noopener noreferrer"><SponsorLogo {...sponsor} /></a>)}</div>
      </div>
    </div>
  </section>

  <section class="home-join container">
    <div><h2>Join the organizing team.</h2><p>Help with problem writing, technology, or event logistics.</p></div>
    <a class="button button-primary" href="/join">Join us</a>
  </section>
</Layout>
