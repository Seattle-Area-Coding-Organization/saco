---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { links, navigation } from '../data/site';

interface Props { title?: string; description?: string; noindex?: boolean; }
const {
  title = 'SACO | Seattle Area Coding Organization',
  description = 'SACO brings pre-college programmers across the Pacific Northwest together through team coding contests, workshops, and shared practice.',
  noindex = false,
} = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(path, Astro.site);
const socialImage = new URL('/brand/social.png', Astro.site);
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Seattle Area Coding Organization',
  alternateName: 'SACO',
  url: Astro.site?.href,
  logo: new URL('/brand/wordmark.png', Astro.site).href,
  description,
  email: links.email.replace('mailto:', ''),
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#191a20" />
    <link rel="icon" href="/brand/icon.svg" type="image/svg+xml" />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SACO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SACO | Seattle Area Coding Organization" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="SACO | Seattle Area Coding Organization" />
    {path === '/' && !noindex && <script type="application/ld+json" set:html={JSON.stringify(organization).replace(/</g, '\\u003c')} />}
    <title>{title}</title>
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('saco-theme');
        if (savedTheme === 'light' || savedTheme === 'dark') document.documentElement.dataset.theme = savedTheme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label="SACO home">
          <img src="/brand/wordmark.png" alt="SACO" width="902" height="311" fetchpriority="high" />
        </a>
        <nav class="desktop-nav" aria-label="Main navigation">
          {navigation.map(item => <a href={item.href} aria-current={path === item.href ? 'page' : path.startsWith(`${item.href}/`) ? 'location' : undefined}>{item.label}</a>)}
        </nav>
        <div class="header-actions">
          <button class="theme-toggle" type="button" aria-label="Switch color theme" title="Switch color theme"><span class="theme-symbol" aria-hidden="true"></span></button>
          <details class="mobile-menu">
            <summary aria-label="Toggle navigation">Menu <span aria-hidden="true">+</span></summary>
            <nav aria-label="Mobile navigation">
              {navigation.map(item => <a href={item.href} aria-current={path === item.href ? 'page' : path.startsWith(`${item.href}/`) ? 'location' : undefined}>{item.label}</a>)}
            </nav>
          </details>
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer container">
      <div class="footer-top">
        <div class="footer-identity">
          <a href="/" class="brand" aria-label="SACO home"><img src="/brand/wordmark.png" alt="SACO" width="902" height="311" loading="lazy" /></a>
          <p>Seattle Area Coding Organization</p>
        </div>
        <nav aria-label="Footer navigation">{navigation.slice(1).map(item => <a href={item.href}>{item.label}</a>)}</nav>
        <div class="footer-contact"><a class="text-link" href={links.discord} target="_blank" rel="noopener noreferrer">SACO on Discord</a><a href={links.email}>sacocoding@gmail.com</a></div>
      </div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} SACO</span></div>
    </footer>
    <script>
      import { initializeControls } from '../scripts/controls.js';
      initializeControls(document, window);
    </script>
  </body>
</html>
