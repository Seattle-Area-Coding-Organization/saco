---
import Layout from '../layouts/Layout.astro';
import SponsorLogo from '../components/SponsorLogo.astro';
import { sponsors, links } from '../data/site';
---
<Layout title="Sponsors | SACO" description="Meet the organizations supporting SACO and the Seattle Area Computing Competition. Get in touch to support the next contest.">
  <section class="page-heading container"><h1>Our sponsors.</h1><p>Thank you to the organizations supporting SACO competitions and programs.</p><a href="#sponsor-contact" class="text-link">Become a sponsor</a></section>
  <section class="sponsor-tiers container" aria-label="Sponsor tiers">{['Platinum', 'Gold', 'Silver', 'Bronze'].map(tier => <section class={`sponsor-tier tier-${tier.toLowerCase()}`} aria-labelledby={`${tier}-tier`}><h2 id={`${tier}-tier`}>{tier}</h2><div class="tier-logos">{sponsors.filter(sponsor => sponsor.tier === tier).map(sponsor => <a href={sponsor.href} target="_blank" rel="noopener noreferrer"><SponsorLogo {...sponsor} /></a>)}{tier === 'Silver' && <p class="tier-available">Available<a class="text-link" href="#sponsor-contact">Become a sponsor</a></p>}</div></section>)}</section>
  <section class="sponsor-contact container" id="sponsor-contact"><h2>Sponsor SACO.</h2><div><p>Interested in supporting our competitions? Get in touch to discuss sponsorship.</p><a class="text-link" href={links.email}>sacocoding@gmail.com</a></div></section>
</Layout>
