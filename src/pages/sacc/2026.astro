---
import Layout from '../../layouts/Layout.astro';

const schedule = [
  ['11:30 am', 'Check-in'],
  ['12:00 pm', 'Opening ceremony'],
  ['12:30 pm', 'Lunch'],
  ['1:00 pm', 'Practice contest'],
  ['1:30 pm', 'Competition'],
  ['4:30 pm', 'Awards (until 5:00 pm)'],
];

const questions = [
  ['Who was eligible?', 'The competition was open to any pre-college student. Prior competitive programming experience was not required.'],
  ['How were teams formed?', 'Teams had three members. Students could register together or sign up individually and ask the organizers for help finding teammates.'],
  ['Which programming languages were supported?', 'C++, Java, and Python were supported. An automated judge checked solutions, and partial credit was not awarded.'],
  ['Were AI tools allowed?', 'AI coding assistants, large language models, and other external code-generation tools were not allowed during the competition.'],
  ['What did participants need?', 'Participants were asked to bring a laptop and charger. Internet access and a free pizza lunch were included.'],
  ['Where was the competition held?', 'SACC 2026 was held in person at Coding Mind Academy, 4006 148th Ave NE, Redmond, WA 98052.'],
];
---
<Layout title="SACC 2026: Contest archive | SACO" description="Contest format, schedule, rules, and photos from the Seattle Area Computing Competition on May 23, 2026, at Coding Mind Academy in Redmond.">
  <section class="event-hero container">
    <div>
      <p class="hero-name">Seattle Area Computing Competition</p>
      <h1>SACC <span>2026</span></h1>
      <p class="event-intro">A look back at our 2026 team programming contest.</p>
      <div class="hero-actions"><a class="button button-primary" href="#event-photos">Event photos</a><a class="text-link" href="/sacc">About SACC</a></div>
    </div>
    <div class="event-summary"><p class="edition-label">Past event</p><p><time datetime="2026-05-23">May 23, 2026</time></p><p>Coding Mind Academy<span>Redmond, Washington</span></p></div>
  </section>
  <section class="event-format container" id="format">
    <h2>The 2026 format.</h2>
    <div><p>Teams worked together on eight algorithmic problems in a three-hour, in-person contest.</p><dl class="event-facts"><div><dt>Team size</dt><dd>3 <span>people</span></dd></div><div><dt>Time limit</dt><dd>3 <span>hours</span></dd></div><div><dt>Problem set</dt><dd>8 <span>problems</span></dd></div><div><dt>Languages</dt><dd class="languages">C++ / Java / Python</dd></div></dl></div>
  </section>
  <section class="event-program container">
    <div class="venue"><h2>Schedule.</h2><p>May 23, 2026<br />All times Pacific.</p><div class="venue-address"><h3>Coding Mind Academy</h3><p>4006 148th Ave NE<br />Redmond, WA 98052</p><a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Coding+Mind+Academy+4006+148th+Ave+NE+Redmond+WA+98052" target="_blank" rel="noopener noreferrer">View map</a></div></div>
    <ol class="schedule">{schedule.map(([time, title]) => <li><span class="schedule-time">{time}</span><h3>{title}</h3></li>)}</ol>
  </section>
  <section class="event-gallery container" id="event-photos"><div class="section-bar"><h2>Event photos.</h2></div><div class="gallery-grid"><figure class="gallery-wide"><img src="/photos/working-together.webp" alt="Competitors comparing ideas around their laptops" width="1200" height="900" loading="lazy" /></figure><figure><img src="/photos/awards.webp" alt="Students and organizers standing together during the awards ceremony" width="1200" height="900" loading="lazy" /></figure><figure><img src="/photos/between-rounds.webp" alt="Students talking together between competition activities" width="1200" height="900" loading="lazy" /></figure></div></section>
  <section class="faq-section container"><h2>2026 details.</h2><div class="faq-list">{questions.map(([question, answer]) => <details><summary>{question}<span aria-hidden="true">+</span></summary><p>{answer}</p></details>)}</div></section>
</Layout>
