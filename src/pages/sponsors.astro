---
import Layout from '../layouts/Layout.astro';
import SponsorLogo from '../components/SponsorLogo.astro';
import { sponsors, links } from '../data/site';
---
<Layout title="Sponsors | SACO" description="Meet the organizations supporting SACO and the Seattle Area Computing Competition. Get in touch to support the next contest.">
  <section class="page-heading container"><h1>Our sponsors.</h1><p>Thank you to the organizations supporting SACO competitions.</p><a class="text-link" href="#sponsor-contact">Support the next contest</a></section>
  <section class="sponsor-tiers container" aria-label="Sponsor tiers">{['Platinum', 'Gold', 'Bronze'].map(tier => <section class={`sponsor-tier tier-${tier.toLowerCase()}`} aria-labelledby={`${tier}-tier`}><h2 id={`${tier}-tier`}>{tier}</h2><div class="tier-logos">{sponsors.filter(sponsor => sponsor.tier === tier).map(sponsor => <a href={sponsor.href} target="_blank" rel="noopener noreferrer"><SponsorLogo {...sponsor} /></a>)}</div></section>)}</section>
  <section class="sponsor-contact container" id="sponsor-contact"><h2>Support the next SACC.</h2><div><p>Help bring students together for in-person competitive programming in the Seattle area. Email us to discuss sponsorship, whether through funding, a venue, food, or prizes.</p><a class="button button-primary" href={`${links.email}?subject=SACC%20sponsorship`}>Become a sponsor</a></div></section>
</Layout>
