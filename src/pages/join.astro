---
import Layout from '../layouts/Layout.astro';
import { links } from '../data/site';
---
<Layout title="Join us | SACO" description="Help organize coding competitions, write problems, and build the SACO community. Apply to join the student team.">
  <section class="join-hero container"><div><h1>Join the team.</h1></div><div><p>Help organize contests, write problems, or build community resources.</p><a class="button button-primary" href={links.application} target="_blank" rel="noopener noreferrer">Apply to SACO</a><p class="application-note">Google Form. Questions? <a href={links.email}>Email us.</a></p></div></section>
  <section class="join-community container"><h2>Join the community.</h2><p>You don’t need to be an organizer to take part.</p><a class="text-link" href={links.discord} target="_blank" rel="noopener noreferrer">Join Discord</a></section>
</Layout>
