---
import Layout from '../layouts/Layout.astro';
import { links } from '../data/site';
---
<Layout title="Join the organizing team | SACO" description="Help organize coding competitions, write problems, and build the SACO community. Apply to join our student organizing team.">
  <section class="join-hero container"><div><h1>Join the team.</h1></div><div><p>Help write contest problems, build our technology, or organize events.</p><a class="button button-primary" href={links.application} target="_blank" rel="noopener noreferrer">Apply to SACO</a><p class="application-note">Questions about joining? <a href={links.email}>Email us.</a></p></div></section>
  <section class="join-community container"><h2>Join the community.</h2><p>Meet other programmers, find teammates, and hear about upcoming events on Discord.</p><a class="text-link" href={links.discord} target="_blank" rel="noopener noreferrer">Join Discord</a></section>
</Layout>
