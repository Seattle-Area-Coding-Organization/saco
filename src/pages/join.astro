---
import Layout from '../layouts/Layout.astro';
import { links } from '../data/site';
---
<Layout title="Organize with us | SACO" description="Write contest problems, build our technology, or help run events. Apply to the SACO student organizing team.">
  <section class="join-hero container"><div><h1>Help run SACO.</h1></div><div><p>There’s plenty to do behind the scenes: write contest problems, work on the website, or help events run smoothly.</p><a class="button button-primary" href={links.application} target="_blank" rel="noopener noreferrer">Apply to the team</a><p class="application-note">Have a question? <a href={links.email}>Email us.</a></p></div></section>
</Layout>
